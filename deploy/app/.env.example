# Copy to deploy/app/.env on the machine that runs Docker Compose.
# Do not commit the copied .env.
OPENSEARCH_VERSION=2.19.0
OPENSEARCH_CLUSTER_NAME=maritime-law-dev
OPENSEARCH_JAVA_OPTS=-Xms2g -Xmx2g
OPENSEARCH_INITIAL_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD_AtLeast8Chars
DEEPSEEK_API_KEY=replace_with_your_key

# Comma-separated emails that receive the administrator console after login.
# Keep this value private and replace it with your team's admin addresses.
ZHOUXU_ADMIN_EMAILS=
# New accounts receive this token quota; administrators can adjust it later.
ZHOUXU_DEFAULT_QUOTA_TOKENS=100000

# Use local image tags when building on this machine. For a registry, replace
# these with fully qualified image names and run docker compose pull.
ZHOUXU_API_IMAGE=zhouxu-api:local
ZHOUXU_WEB_IMAGE=zhouxu-web:local
ZHOUXU_WEB_PORT=8080
ZHOUXU_RUNTIME_ENV_FILE=.env
